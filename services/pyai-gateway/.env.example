# PyAI gateway — never commit real keys.
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com/v1
PYAI_GATEWAY_PORT=3002
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PYAI_SANDBOX_MINT_PATH=/sandbox/keys

# Local data (empty = gateway .data / ~/Margin)
NOTEWISE_PYAI_DATA_DIR=
MARGIN_DIR=

# Fallback Recap pack for templated modes (General mode omits pack_id → PyAI platform default)
PYAI_RECAP_PACK_ID=notewise_sales_discovery
PYAI_RECAP_ENABLED=true

# Meeting brain fallback when PyAI Recap scope is missing (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Auth + Google Calendar (create credentials at https://console.cloud.google.com/)
# For desktop DMG: copy these into ~/Library/Application Support/com.notewise.app/data/gateway.env
AUTH_JWT_SECRET=
AUTH_JWT_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3002/auth/google/callback
WEB_APP_URL=http://127.0.0.1:5173
# Desktop OAuth loopback port (must match Notewise app; default 17654)
NOTEWISE_OAUTH_PORT=17654
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.readonly
