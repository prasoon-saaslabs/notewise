# Env default when Settings → "Use env default" (page URL stays :5173).
# In the UI, prefer Settings → Nest (:3001) or PyAI (:3002) for instant switching.
VITE_API_URL=/api

# Only used when VITE_API_URL=/api (Vite same-origin proxy). Restart Vite after change.
VITE_PROXY_TARGET=http://127.0.0.1:3002
