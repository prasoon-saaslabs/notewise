# Public marketing-site URLs (baked in at `pnpm build:website`). Never put secrets here.
# Copy to .env.local for local preview, or set the same names in the Vercel project.

# Apple Silicon (or universal) GitHub Release asset URL
VITE_DMG_URL=

# Optional Intel Mac GitHub Release asset URL
VITE_DMG_URL_INTEL=

# Public GitHub repo
VITE_GITHUB_URL=https://github.com/prasoon-saaslabs/notewise
