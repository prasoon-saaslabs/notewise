{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notewise",
  "version": "0.1.0",
  "identifier": "com.notewise.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @notewise/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "VITE_API_URL=http://127.0.0.1:3002 VITE_DESKTOP_PYAI_ONLY=true pnpm --filter @notewise/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notewise",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://127.0.0.1:3002 ws://127.0.0.1:3002; connect-src 'self' tauri: http://127.0.0.1:3002 ws://127.0.0.1:3002; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/notewise-gateway"],
    "resources": ["resources/pyai-gateway/"],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        }
      }
    }
  }
}
