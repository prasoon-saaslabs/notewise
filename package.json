{
  "name": "notewise",
  "private": true,
  "version": "0.1.0",
  "description": "Notewise — AI meeting notes (web, desktop, mobile)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @notewise/web dev",
    "dev:website": "pnpm --filter @notewise/website dev",
    "dev:api": "pnpm --filter @notewise/api start:dev",
    "dev:desktop": "pnpm --filter @notewise/desktop tauri:dev",
    "dev:pyai-gateway": "cd services/pyai-gateway && . .venv/bin/activate && uvicorn app.main:app --host 127.0.0.1 --port 3002",
    "build:website": "pnpm --filter @notewise/website build",
    "build:desktop:dmg": "bash apps/desktop/scripts/stage-pyai-gateway.sh && source \"$HOME/.cargo/env\" 2>/dev/null; pnpm --filter @notewise/desktop tauri:build:dmg",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
