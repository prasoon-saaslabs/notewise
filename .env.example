# Notewise API / worker — copy to .env and fill values. Never commit real secrets.

# NestJS API
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AI_WORKER_URL=http://127.0.0.1:8001

DATABASE_URL=postgresql://notewise:notewise@localhost:5432/notewise
REDIS_URL=redis://localhost:6379

# Provider selection
STT_PROVIDER=whisper_cli
DIARIZATION_PROVIDER=stub
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=mfcc
MEETING_BOT_PROVIDER=auto

# LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# STT
WHISPER_MODEL=base
HF_TOKEN=

# Meeting bot — Meeting BaaS for real Meet/Zoom/Teams participants
# Get a key at https://meetingbaas.com — leave empty for sandbox (live notes UI only)
MEETING_BOT_API_KEY=
MEETING_BOT_API_URL=https://api.meetingbaas.com
# v2 for keys that start with mb- (Meeting BaaS dashboard). Use v1 only for legacy keys.
MEETING_BOT_API_VERSION=v2
MEETING_BOT_WEBHOOK_SECRET=
# Public base URL for webhooks (ngrok etc.) e.g. https://abc.ngrok.io
MEETING_BOT_WEBHOOK_BASE_URL=

AI_WORKER_PORT=8001

# --- Parallel PyAI gateway (services/pyai-gateway, port 3002) ---
# Copy also to services/pyai-gateway/.env — never put this key in Vite.
PYAI_API_KEY=
PYAI_GATEWAY_PORT=3002
MARGIN_DIR=
PYAI_RECAP_PACK_ID=sales_outbound
