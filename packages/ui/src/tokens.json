{
  "name": "Notewise",
  "version": "0.1.0",
  "description": "Editorial light product UI — calm document-first STT notes",
  "color": {
    "ink": "#0c1222",
    "ink2": "#1e293b",
    "ink3": "#64748b",
    "ink4": "#94a3b8",
    "paper": "#f7f6f3",
    "surface": "#ffffff",
    "surface2": "#f3f2ee",
    "surface3": "#eae8e2",
    "border": "#e4e2db",
    "borderStrong": "#d4d1c8",
    "accent": "#0f766e",
    "accentDark": "#0d5f59",
    "accentSoft": "#e6f4f2",
    "accentMuted": "#14b8a6",
    "danger": "#b91c1c",
    "dangerSoft": "#fef2f2",
    "success": "#047857",
    "successSoft": "#ecfdf5",
    "warning": "#b45309",
    "warningSoft": "#fffbeb",
    "you": "#0f766e",
    "other": "#4338ca",
    "guest": "#a16207"
  },
  "typography": {
    "fontSans": "\"Geist\", \"Inter\", ui-sans-serif, system-ui, sans-serif",
    "fontMono": "\"Geist Mono\", ui-monospace, monospace",
    "sizes": {
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "md": "0.875rem",
      "lg": "1rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "display": "2.75rem"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeights": {
      "tight": 1.2,
      "snug": 1.35,
      "body": 1.55,
      "relaxed": 1.65
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgb(12 18 34 / 0.04)",
    "md": "0 1px 2px rgb(12 18 34 / 0.04), 0 8px 24px rgb(12 18 34 / 0.06)",
    "lg": "0 12px 40px rgb(12 18 34 / 0.1)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "layout": {
    "shellMax": "1200px",
    "sidebar": "300px",
    "recorder": "280px",
    "headerH": "56px",
    "touchMin": "40px"
  }
}
